{
    "name": "kopling/oauth",
    "description": "OAuth 2.1 authorization server for Kopling: lets apps and AI assistants act on a person's behalf, with their consent.",
    "type": "kopling-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniël Klabbers",
            "email": "daniel@klabbers.email"
        }
    ],
    "require": {
        "laravel/passport": "^13.10",
        "phpseclib/phpseclib": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kopling\\OAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kopling\\OAuth\\ServiceProvider"
            ]
        }
    }
}
